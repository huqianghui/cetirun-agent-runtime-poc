# ---- 部署运行时状态：kubeconfig、私钥、各资源 ID，绝不提交 ----
/state/
/generated/
/config.env
*.pem
*.key
*.log
*.pptx
~$*
# bin/ 只提交 docker 替身；kubectl/kubelogin 首次运行时下载
!/bin/
/bin/*
!/bin/docker


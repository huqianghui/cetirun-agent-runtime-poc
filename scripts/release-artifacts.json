    {"name": "hermes-gateway", "script": "scripts/cetirun-docker-build.sh", "env": {"BUILD_HERMES": "true"}},
    {"name": "cetirun-desktop", "script": "scripts/cetirun-docker-build.sh", "env": {"BUILD_DESKTOP": "true"}},
    {"name": "cetirun-operator", "script": "scripts/operator-docker-build.sh"},
    {"name": "cetirun-ai-gateway", "script": "scripts/ai-gateway-docker-build.sh"},
    {"name": "cetirun-agent-broker", "script": "scripts/agent-broker-docker-build.sh"},
    {"name": "cetirun-connections-mcp", "script": "scripts/cetirun-connections-mcp-docker-build.sh"},

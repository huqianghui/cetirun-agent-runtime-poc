# CetiRun PoC 环境配置模板。复制成 config.env 后填写，所有脚本都从 config.env 读。
SUBSCRIPTION_ID=<你的订阅 ID>
LOCATION=eastus2
RG=rg-cetirun-poc                  # 全部资源放这里
NODE_RG=rg-cetirun-poc-nodes       # AKS 必须有的节点资源组，固定名字，同样打标签
CLUSTER_NAME=aks-cetirun-poc
TAGS="securityControl=Ignore costControl=Ignore project=cetirun-poc"

# CetiRun 源码与发布版本。REGISTRY 是复制来源；实际部署用 45-registry.sh 自建的 ACR（state/registry.env）
CETIRUN_SRC=$ROOT                  # 源码就是本仓库
REGISTRY=mcr.microsoft.com/aks/ai-runtime/cetirun
VERSION=0.1.1

# 模型：AIServices 账号（15-models.sh 创建），部署 gpt-5.6-luna / gpt-5.6-terra
AI_ACCOUNT=ai-cetirun-poc-<后缀>    # 也是子域名，全局唯一
OWNER_ALIAS=<你的别名>                  # 门户管理员别名（CetiAdmin owner）
PORTAL_ADMIN_ALIASES=""                # 其他门户管理员（Entra 登录名 @ 前面那段），OWNER_ALIAS 自动包含
MAX_AGENTS_PER_USER=2                  # 每人可建的 agent 数，0 为不限

# 节点池（PoC 规格，远小于源码默认值）
SYSTEM_VM=Standard_D4s_v5
SYSTEM_MIN=2
SYSTEM_MAX=3
AGENT_VM=Standard_D16s_v5          # Kata 池，一台能放约 3 个常驻实例
AGENT_MIN=1
AGENT_MAX=3

# 门户域名：公网 IP 自带的 cloudapp 域名
DNS_LABEL=cetirun-<后缀>          # 门户地址 https://<DNS_LABEL>.<LOCATION>.cloudapp.azure.com/
# ---- 登录与权限 ----
LOGIN_GROUP=cetirun-poc-users          # 能登录门户的 Entra 组（30-identity.sh 不存在就创建）

# ---- 模型（15-models.sh 部署，50-environment.sh 写进 AI 网关）----
# 每项 名字:模型版本:输入单价:输出单价（美元/token），空格分隔；名字既是模型名也是部署名
MODELS="gpt-5.6-luna:2026-07-09:0.00000025:0.000002 gpt-5.6-terra:2026-07-09:0.00000125:0.00001"
MODEL_SKU=GlobalStandard
MODEL_CAPACITY=100                     # 每个部署的容量（千 TPM）
AOAI_API_VERSION=2025-04-01-preview
DEFAULT_MODEL=gpt-5.6-terra            # CetiAdmin 默认用的模型，必须在 MODELS 里
CETIADMIN_BUDGET_USD=50                # CetiAdmin 的初始月度预算

# ---- 版本 ----
K8S_VERSION=1.37                       # AKS 版本
KUBECTL_VERSION=1.37.1                 # 本机 bin/kubectl，和集群版本差不超过一个小版本
CERT_MANAGER_VERSION=v1.21.3
BUILD_VERSION=0.1.1-src.20261119       # 46 构建、56 部署的版本号；改了源码就换一个新值再重跑 46
MCR_GIT_SHA=0af84e718108aa0700620a798d84b561c706b0b0   # 还没跑 46 时，50 按 MCR 的 VERSION 生成配置用

# ---- 第二个 Kata 池（按需扩容，平时 0 台）----
AGENT2_VM=Standard_D8s_v5
AGENT2_MIN=0
AGENT2_MAX=1

# ---- 构建机（46-build-publish.sh，构建完自动解除分配）----
BUILD_VM=vm-cetirun-build
BUILD_VM_SIZE=Standard_D8s_v5
BUILD_VM_IMAGE=Ubuntu2404

# ---- 存储 ----
AGENT_STORAGE_SIZE=20Gi                # 自定义 runtime agent 的 HOME 盘
GATEWAY_DB_SIZE=20Gi                   # AI 网关自带 PostgreSQL 的盘

# ---- 沙箱执行（55-sandbox-platform.sh）----
SANDBOX_HOME_STORAGE_CLASS=sandbox-home   # agent HOME 盘的 StorageClass，门户 Sandbox 里选它
SANDBOX_HOME_DISK_SKU=Premium_LRS
# 入口网关能连 agent 的端口：18789 OpenClaw、8642 Hermes API、9120 Hermes Web、7681 Terminal、6080 Desktop
SANDBOX_INGRESS_PORTS="18789 8642 9120 7681 6080"

CETIRUN_SRC_REF=$CETIRUN_SRC

# CetiRun PoC 环境配置模板。复制成 config.env 后填写，所有脚本都从 config.env 读。
SUBSCRIPTION_ID=<你的订阅 ID>
LOCATION=eastus2
RG=rg-cetirun-poc                  # 全部资源放这里
NODE_RG=rg-cetirun-poc-nodes       # AKS 必须有的节点资源组，固定名字，同样打标签
CLUSTER_NAME=aks-cetirun-poc
TAGS="securityControl=Ignore costControl=Ignore project=cetirun-poc"

# CetiRun 源码与发布版本。REGISTRY 是复制来源；实际部署用 45-registry.sh 自建的 ACR（state/registry.env）
CETIRUN_SRC=$ROOT                  # 源码就是本仓库
REGISTRY=mcr.microsoft.com/aks/ai-runtime/cetirun
VERSION=0.1.1

# 模型：AIServices 账号（15-models.sh 创建），部署 gpt-5.6-luna / gpt-5.6-terra
AI_ACCOUNT=ai-cetirun-poc-<后缀>    # 也是子域名，全局唯一
OWNER_ALIAS=<你的别名>                  # 门户管理员别名（CetiAdmin owner）

# 节点池（PoC 规格，远小于源码默认值）
SYSTEM_VM=Standard_D4s_v5
SYSTEM_MIN=2
SYSTEM_MAX=3
AGENT_VM=Standard_D16s_v5          # Kata 池，一台能放约 3 个常驻实例
AGENT_MIN=1
AGENT_MAX=3

# 门户域名：公网 IP 自带的 cloudapp 域名
DNS_LABEL=cetirun-<后缀>          # 门户地址 https://<DNS_LABEL>.<LOCATION>.cloudapp.azure.com/
CETIRUN_SRC_REF=$CETIRUN_SRC
